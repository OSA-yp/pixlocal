{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs && node scripts/generate-pwa-icons.mjs",
    "build": "next build && node scripts/flatten-default-locale.mjs && node scripts/write-legacy-ru-redirects.mjs && node scripts/write-en-prefix-redirects.mjs && node scripts/build-sw.mjs",
    "start": "next start",
    "lint": "eslint",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:dry": "node scripts/indexnow.mjs --dry-run"
  },
  "dependencies": {
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "exifr": "^7.1.3",
    "heic-to": "1.5.2",
    "jszip": "^3.10.2",
    "next": "15.5.25",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@serwist/build": "^9.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@swc/helpers": "^0.5.23"
  }
